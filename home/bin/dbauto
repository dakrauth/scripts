#!/usr/bin/env python
import sys
from pathlib import Path


class File:
    def __init__(self, filename):
        self.path = Path(filename)
        self.name = filename.name[:10]
        self.size = self.path.stat().st_size

    def __str__(self):
        return f"{self.path} ({self.size:,})"



class Result:
    def __init__(self, dirname, nfiles, nbytes):
        self.dirname = dirname
        self.nfiles = nfiles
        self.nbytes = nbytes

    def __str__(self):
        return f"# Removed {self.nfiles} files, {self.nbytes:,} bytes from {self.dirname}"


def clean(dirname, delete=True, **opts):
    p = Path(dirname)
    months = {}
    for fn in sorted(p.glob("*.gz")):
        ts, _, suffix = fn.name.partition(".")
        try:
            yr, mo, *_ = [int(i) for i in ts.split("-")]
        except ValueError:
            print(f"! Skipping {fn}")
            continue

        f = File(fn)
        if f.size == 0:
            print(f"! {f.path} has a length of 0")
            f.path.unlink()
            continue

        months.setdefault((yr, mo), []).append(f)

    removed = 0
    size = 0
    for key, values in months.items():
        if len(values) < 2:
            continue

        keep = values.pop()
        print(f"* {key[0]}-{key[1]} keeps {keep.name}, would delete:")
        print("\n".join(f"  - {d.name}" for d in values))
        removed += len(values)

        size += sum(f.size for f in values)
        for f in values:
            if delete:
                f.path.unlink()
            else:
                print(f"~ File {f} would be deleted")

    return Result(dirname, removed, size)


def parse_args():
    args = sys.argv[1:]
    opts = {}
    dirnames = []
    for arg in args:
        if arg.startswith("--"):
            arg = arg[2:]
            key, _, val = arg.partition("=")
            no = key.startswith("no-")
            if not val:
                val = False if no else True

            if no:
                key = key[3:]

            opts[key.replace("-", "_")] = val
        else:
            dirnames.append(arg)

    return dirnames, opts


def main():
    dirnames, opts = parse_args()
    if not dirnames:
        print("Provide path(s) for directories to clean")
        return 1

    results = []
    for arg in dirnames:
        result = clean(arg, **opts)
        results.append(result)
        print(result)

    if len(results) > 1:
        nfiles = sum(r.nfiles for r in results)
        nbytes = sum(r.nbytes for r in results)
        print(f"## TOTAL: Removed {nfiles} files, {nbytes:,} bytes")

    return 0


if __name__ == '__main__':
    sys.exit(main())
