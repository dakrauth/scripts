#!/usr/bin/env bash
# set -x
DBBAK_DIR=/Users/david/dev/bak
DBBAK_NAMES=(travel picker idope)  # bdp
DBBAK_PORT=13306
DBBAK_HOST=0.0.0.0

# use mysql_config_editor set -u user -P port -h host -p
# for example,  mysql_config_editor set -h 0.0.0.0 -u root -P 13306 -p

mkdir -p ${DBBAK_DIR}

function dbdump() {
    local items="$*"
    if [ -z "$1" ]; then
        items=("${DBBAK_NAMES[@]}")
        echo Dumping default DBs...
    else
        echo Dumping selected DBs...
    fi
    echo "${items[@]}"

    for name in "${items[@]}"; do
        local SQLFILE=${name}.sql
        local OUTFILE=${SQLFILE}.gz
        local WHEN=$(date "+%Y-%m-%d-%H-%M")
        local WHERE="${DBBAK_DIR}/${name}"
        echo "${WHEN} Dumping ${name} to ${WHERE} ..."

        mkdir -p "${WHERE}"
        pushd "${WHERE}" > /dev/null || exit

        echo "Removing ${SQLFILE}, ${OUTFILE}"
        rm -f "${SQLFILE}" "${OUTFILE}"

        echo "Downloading mysqldump to ${OUTFILE} ..."
        if [ "${name}" = "travel" ]; then
            ssh dak "mysqldump --default-character-set=utf8mb4 travel | gzip" > "${OUTFILE}"
        elif [ "${name}" = "picker" ]; then
            ssh dak "mysqldump --default-character-set=utf8mb4 picker | gzip" > "${OUTFILE}"
        elif [ "${name}" = "idope" ]; then
            ssh dak "mysqldump --default-character-set=utf8mb4 idope | gzip" > "${OUTFILE}"
        elif [ "${name}" = "bdp" ]; then
            ssh david@ballroomdanceportland.com "mysqldump bdp | gzip" > "${OUTFILE}"
        else
            ssh dak "mysqldump ${name} | gzip" > "${OUTFILE}"
        fi
        echo "Download complete."

        cp "${OUTFILE}" "${WHEN}.${OUTFILE}"
        popd > /dev/null || exit
        echo Done.
    done
}

function dbload() {
    local names="$*"
    if [ -z "$1" ]; then
        names=("${DBBAK_NAMES[@]}")
        echo Loading default DBs...
    else
        echo Loading selected DBs...
    fi
    echo "${names[@]}"

    for name in "${names[@]}"; do
        local sqlfile="${DBBAK_DIR}/${name}/${name}.sql.gz"
        if [ ! -e "$sqlfile" ]; then
            dbdump "$name"
        fi
        echo "Loading $name ${DBBAK_HOST}:${DBBAK_PORT} "$sqlfile""
        gunzip -c "$sqlfile" | mysql -u root -P "$DBBAK_PORT" -h "$DBBAK_HOST" "$name"
        echo "Done ($?)."
    done

}

function dbreload() {
    dbdump "$@"
    dbload "$@"
}
